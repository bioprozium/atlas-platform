  "info": {
    "title": "Open 3D Atlas API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/anatomy/structures": {
      "get": {
        "description": "List published structures with preferred names in code order.",
        "operationId": "listAnatomicalStructures",
        "parameters": [
          {
            "description": "Maximum number of items to return.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "description": "Maximum number of items to return.",
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "description": "Number of matching items to skip.",
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "description": "Number of matching items to skip.",
              "maximum": 9223372036854775807,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          },
          {
            "description": "Include members of this published system.",
            "in": "query",
            "name": "system_code",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 80,
                  "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Include members of this published system.",
              "title": "System Code"
            }
          },
          {
            "in": "query",
            "name": "laterality",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Laterality"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Laterality"
            }
          },
          {
            "description": "Require a name in this language. Also limits the names matched by q.",
            "in": "query",
            "name": "language",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Language"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Require a name in this language. Also limits the names matched by q.",
              "title": "Language"
            }
          },
          {
            "description": "Substring of a preferred name or synonym.",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 255,
                  "minLength": 1,
                  "pattern": "^[^\\x00]+$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Substring of a preferred name or synonym.",
              "title": "Q"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_StructureSummary_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The anatomy database is unavailable."
          }
        },
        "summary": "List Structures",
        "tags": [
          "Anatomy"
        ]
      }
    },
    "/api/v1/anatomy/structures/{code}": {
      "get": {
        "description": "Retrieve a published structure with names, system memberships, and external identifiers.",
        "operationId": "getAnatomicalStructure",
        "parameters": [
          {
            "description": "Stable public code.",
            "in": "path",
            "name": "code",
            "required": true,
            "schema": {
              "description": "Stable public code.",
              "maxLength": 80,
              "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
              "title": "Code",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StructureDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The published structure was not found."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The anatomy database is unavailable."
          }
        },
        "summary": "Get Structure",
        "tags": [
          "Anatomy"
        ]
      }
    },
    "/api/v1/anatomy/structures/{code}/relations": {
      "get": {
        "description": "List direct relations between published structures in source, target, and type order.",
        "operationId": "listAnatomicalStructureRelations",
        "parameters": [
          {
            "description": "Stable public code.",
            "in": "path",
            "name": "code",
            "required": true,
            "schema": {
              "description": "Stable public code.",
              "maxLength": 80,
              "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
              "title": "Code",
              "type": "string"
            }
          },
          {
            "description": "Maximum number of items to return.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "description": "Maximum number of items to return.",
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "description": "Number of matching items to skip.",
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "description": "Number of matching items to skip.",
              "maximum": 9223372036854775807,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "relation_type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/RelationType"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Relation Type"
            }
          },
          {
            "description": "Direction relative to the requested structure. Omit for both directions.",
            "in": "query",
            "name": "direction",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Direction"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Direction relative to the requested structure. Omit for both directions.",
              "title": "Direction"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_StructureRelation_"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The published structure was not found."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The anatomy database is unavailable."
          }
        },
        "summary": "List Relations",
        "tags": [
          "Anatomy"
        ]
      }
    },
